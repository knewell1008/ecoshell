{
  "name": "ecoshell",
  "main": "src/index.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "SUPABASE_URL": "https://bogzsjzqdewbsgglqvpr.supabase.co"
  },
  // SUPABASE_SERVICE_ROLE_KEY is a Worker secret, set in the dashboard under
  // Settings > Variables and Secrets (or with `wrangler secret put`).
  "keep_vars": true
}
